# Kopieren nach ".env" und mit eigenen lokalen Werten befuellen.
# Diese Beispieldatei enthaelt bewusst keine echten Zugangsdaten oder Schluessel.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=bachelorarbeit_validation
DB_USER=postgres
DB_PASSWORD=

# Nur erforderlich fuer den optionalen Stripe-Test-API-Import (Anhang C.3).
# Muss mit sk_test_ beginnen (Stripe TEST-Modus, kein Live-Key).
STRIPE_SECRET_KEY=
